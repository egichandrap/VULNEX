FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/vulnex-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata nmap curl
WORKDIR /app
COPY --from=builder /bin/vulnex-worker /app/vulnex-worker
ENTRYPOINT ["/app/vulnex-worker"]
